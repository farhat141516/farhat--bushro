{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "{*.html,*.js,*.css,*.json,*.yaml,*.png,uploads/**}",
      "excludeFiles": "{.env,.env.*,**/.env,**/.env.*}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?route=/$1"
    }
  ]
}
