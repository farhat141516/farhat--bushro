# A private HTTPS endpoint that accepts application JSON (CRM, serverless function, or mail provider).
# Keep this value only in the deployment environment; never expose it in client-side files.
APPLICATION_WEBHOOK_URL=https://your-secure-service.example/api/applications
# PostgreSQL connection URL. Set it in the server environment, not in client-side code.
# Example: postgresql://app_user:strong-password@localhost:5432/al_bushra
DATABASE_URL=postgresql://app_user:strong-password@localhost:5432/al_bushra
# Set to true only when the hosted provider requires TLS and supplies a trusted certificate.
DATABASE_SSL=false
PORT=3000
ADMIN_PORT=3001
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-long-random-secret
